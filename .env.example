# Backend API port
PORT=3001

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=amazon_data_collection

# Collector behavior
COLLECT_MAX_PAGES=20
COLLECT_MAX_PRODUCTS=200
COLLECT_DELAY_MS=3000
COLLECT_LISTING_PAGE_DELAY_MS=500
COLLECT_CONCURRENCY=5

# Ozon collection (same style as Amazon: paste product/seller URL)
OZON_MAX_PRODUCTS=200
OZON_MAX_PAGES=5
OZON_DELAY_MS=800
OZON_LISTING_PAGE_DELAY_MS=500
OZON_TIMEOUT_SECONDS=45
# 本机 Chrome CDP 采集（接入你已打开的浏览器，不要另开无头浏览器）
# 1) 运行 start-ozon-chrome.ps1
# 2) 在弹出的 Chrome 里打开 ozon.ru 完成验证
# 3) 保持该窗口开着，再启动后端采集
OZON_BROWSER_ENABLED=true
OZON_BROWSER_CDP_URL=http://127.0.0.1:9222
# 默认 false：不另开 Playwright 浏览器（极易被反爬）
OZON_BROWSER_LAUNCH_FALLBACK=false
OZON_BROWSER_HEADLESS=true
# 类目解析：默认走同一调试 Chrome 的 seller.ozon.ru（免手贴 Cookie）
OZON_SELLER_USE_CDP=true
# 可选 Cookie：仅 HTTP 兜底
# 登录 seller.ozon.ru 或 ozon.ru → F12 → 网络 → 复制 Cookie
OZON_COOKIE=
# 可选覆盖：仅当卖家后台 Cookie 必须与前台不同时再填；不填则自动复用 OZON_COOKIE
OZON_SELLER_COOKIE=
OZON_IMPERSONATE=edge101

# 1688 阿里牛顿以图搜货
# 推荐：同一调试 Chrome 登录图搜首页（start-ozon-chrome.ps1 会打开），实时读 Cookie
# https://air.1688.com/app/1688-lp/landing-page/home/inventory/products.html?bizType=browser&customerId=AIBUY
# 可选兜底：手动粘贴 Cookie（含 _m_h5_tk，易过期）
1688_COOKIE=
1688_USE_CDP=true
1688_MAX_RESULTS=10
1688_IMPERSONATE=chrome131
1688_TIMEOUT_SECONDS=60

# DeepSeek AI 商品编辑（platform.deepseek.com → API keys）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=120

# Ozon Seller API 上架（seller.ozon.ru → 设置 → API 密钥）
OZON_SELLER_CLIENT_ID=
OZON_SELLER_API_KEY=
OZON_SELLER_BASE_URL=https://api-seller.ozon.ru
OZON_SELLER_TIMEOUT_SECONDS=60
OZON_SELLER_UI_BASE_URL=https://seller.ozon.ru
# rFBS 仓库 ID（库存推送用；可在卖家后台仓库列表查看）
OZON_WAREHOUSE_ID=1020005027989850
# 税率与货币（currency_code 必须与卖家合同一致；跨境中卖常见为 CNY，本土店多为 RUB）
OZON_VAT=0
OZON_CURRENCY_CODE=CNY
# 品牌属性：默认填「无品牌」字典值（可按后台字典调整）
OZON_BRAND_ATTRIBUTE_ID=85
OZON_NO_BRAND_DICTIONARY_VALUE_ID=126745801

# 定价：理解 A = (货本+运费)×1.30/(1-0.20)×汇率
OZON_RUB_PER_CNY=12
OZON_DEFAULT_STOCK_QTY=99
# 仅用于运费估算缺重量时的兜底
OZON_DEFAULT_WEIGHT_G=200

# 全站强制统一包裹尺寸（上架 depth/width/height/weight）
OZON_FORCE_PACKAGE_METRICS=true
OZON_FIXED_DEPTH_MM=100
OZON_FIXED_WIDTH_MM=100
OZON_FIXED_HEIGHT_MM=100
OZON_FIXED_WEIGHT_G=200

# 店铺流水线：流行 Top N → 搜货选供 → AI → 审核 → 自动推送
SHOP_PIPELINE_TOP_N=50
SHOP_PIPELINE_SUPPLIER_TOP_N=5
SHOP_PIPELINE_CONCURRENCY=4
SHOP_PIPELINE_AUTO_RETRY=3
# 流水线默认不转存 OSS（更快；俄区直连 Ozon CDN 更稳）
SHOP_PIPELINE_REHOST_IMAGES=false
CONTENT_SCORE_MIN=57
PUBLISH_HEAL_MAX_ATTEMPTS=5
# 审核通过后是否模拟推送（false=真实推送到 Ozon）
OZON_AUTO_PUBLISH_SIMULATE=false

# 阿里云 OSS（新加坡桶，图片转存）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_PUBLIC_BASE_URL=
